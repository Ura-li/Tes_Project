generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model asset_information {
  AssetID             Int                  @id @default(autoincrement())
  SerialNumber        String               @db.VarChar(20)
  ProductNumber       String               @db.VarChar(11)
  SiteAccountID       Int?
  ContactID           Int?
  Warranty_Status     String?
  EOW_Date            DateTime?            @db.DateTime(0)
  WarrantyOTCCode     OTCCodeTable?        @relation(fields: [Warranty_Status], references: [OTCCode])

  site_account        site_account?        @relation(fields: [SiteAccountID], references: [SiteAccountID], onDelete: Restrict, onUpdate: Restrict, map: "asset_information_ibfk_1")
  contact_information contact_information? @relation(fields: [ContactID], references: [ContactID], onDelete: Restrict, onUpdate: Restrict, map: "asset_information_ibfk_2")
  product_information product_information  @relation(fields: [ProductNumber], references: [ProductNumber], onUpdate: Restrict, map: "asset_information_ibfk_3")
  asset_waranty       asset_warranty[]
  caseinformation     caseinformation[]
  servicecatalog      servicecatalog[]

  @@index([ContactID], map: "ContactID")
  @@index([ProductNumber], map: "ProductNumber")
  @@index([SiteAccountID], map: "SiteAccountID")
}

model asset_warranty {
  WarrantyID  Int @id @default(autoincrement())
  AssetID     Int? 
  asset_information asset_information? @relation(fields: [AssetID], references: [AssetID], onDelete: Restrict, onUpdate: Cascade, map: "asset_warranty_ibfk_1")

  @@index([AssetID], map:"AssetID")
}

model caseinformation {
  CaseID                                        String               @id
  SiteAccountID                                 Int?
  ContactID                                     Int?
  AssetID                                       Int?
  id_gtc                                        Int?
  id_csr                                        Int?
  CaseID_Manual                                 String?
  CaseID_Manual_Date                            DateTime?            @db.DateTime(0)
  ReferenceCase                                 String?
  CaseSubject                                   String?              @db.VarChar(255)
  CaseType                                      String?              @db.VarChar(100)
  KCI_Flag                                      Boolean?             @default(false)
  IncomingChannel                               String?              @db.VarChar(100)
  CaseStatus                                    CaseStatus           @default(Open)
  CasePriority                                  String?              @db.VarChar(50)
  CustomerSeverity                              String?              @db.VarChar(50)
  CreatedOn                                     DateTime?            @default(now()) @db.DateTime(0)
  CaseClosedDate                                DateTime?            @db.DateTime(0)
  CaseNote                                      Int?
  SymptomCode                                   Int?
  CaseResolution                                String?              @db.Text
  CreatedBy                                     Int?
  Owner                                         Int?
  WorkGround                                    Int?
  site_account                                  site_account?        @relation(fields: [SiteAccountID], references: [SiteAccountID], onDelete: Restrict, onUpdate: Restrict, map: "caseinformation_ibfk_1")
  contact_information                           contact_information? @relation(fields: [ContactID], references: [ContactID], onDelete: Restrict, onUpdate: Restrict, map: "caseinformation_ibfk_2")
  asset_information                             asset_information?   @relation(fields: [AssetID], references: [AssetID], onDelete: Restrict, onUpdate: Restrict, map: "caseinformation_ibfk_3")
  casenotes_caseinformation_CaseNoteTocasenotes casenotes?           @relation("caseinformation_CaseNoteTocasenotes", fields: [CaseNote], references: [NoteID], onDelete: Restrict, onUpdate: Restrict, map: "caseinformation_ibfk_4")
  symptom_codes                                 symptom_codes?       @relation(fields: [SymptomCode], references: [SymptomCodeID], onDelete: Restrict, onUpdate: Restrict, map: "caseinformation_ibfk_5")
  casenotes_casenotes_CaseIDTocaseinformation   casenotes[]          @relation("casenotes_CaseIDTocaseinformation")
  workorder                                     workorder[]
  createdByUser                                 User?                @relation("UserCreatedCases", fields: [CreatedBy], references: [IDUser], onDelete: Restrict, onUpdate: Cascade)
  ownerUser                                     User?                @relation("UserOwnedCases", fields: [Owner], references: [IDUser], onDelete: Restrict, onUpdate: Cascade)
  ServiceCatalogID                              Int?
  servicecatalog                                servicecatalog?      @relation(fields: [ServiceCatalogID], references: [ServiceCatalogID], onDelete: Restrict)
  global_trade_check                            global_trade_check?  @relation(fields: [id_gtc], references: [id_gtc], onDelete: Restrict)
  caseresolution                                caseresolution?      @relation(fields: [id_csr], references: [id_csr], onDelete: Restrict)
  OTCCode                                       String?              @db.VarChar(5) // Scalar field
  otcCodeTable                                  OTCCodeTable?        @relation(fields: [OTCCode], references: [OTCCode])
  ProblemDescription                            String?              @db.VarChar(255)
  CaseProductNote                               String?              @db.Text
  accessory                                     accessory[]
  ActionLog                                     ActionLog[]

  @@index([AssetID], map: "AssetID")
  @@index([CaseNote], map: "CaseNote")
  @@index([ContactID], map: "ContactID")
  @@index([SiteAccountID], map: "SiteAccountID")
  @@index([SymptomCode], map: "SymptomCode")
  @@index([CreatedBy])
  @@index([id_gtc])
  @@index([OTCCode])
  @@index([id_csr])
}

model OTCCodeTable {
  OTCCode     String    @id @db.VarChar(5)
  Description String    @db.VarChar(100)
  CreatedOn   DateTime? @default(now()) @db.DateTime(0)

  cases caseinformation[]
  asset asset_information[]
}

model accessory {
  id          Int             @id @default(autoincrement())
  CaseID      String // FK to caseinformation
  Accessories String
  Note        String?
  CT_SNCode   String?
  case        caseinformation @relation(fields: [CaseID], references: [CaseID], onDelete: Cascade)

  @@index([CaseID])
}

model casenotes {
  NoteID     Int     @id @default(autoincrement())
  CaseID     String?
  LogType    String? @db.VarChar(50)
  ActionType String?

  // actionTypeInfo  actiontypecasenotes? @relation("ActionTypeToCasenotes", fields: [ActionTypeID], references: [ActionID])

  Template          String?   @db.VarChar(100)
  VisibleExternally Boolean?  @default(false)
  MinutesSpent      Int?
  Note              String?   @db.Text
  CreatedOn         DateTime? @default(now()) @db.DateTime(0)
  CreatedBy         Int?

  caseinformation_caseinformation_CaseNoteTocasenotes caseinformation[] @relation("caseinformation_CaseNoteTocasenotes")
  caseinformation_casenotes_CaseIDTocaseinformation   caseinformation?  @relation("casenotes_CaseIDTocaseinformation", fields: [CaseID], references: [CaseID], onDelete: Restrict, onUpdate: Restrict, map: "casenotes_ibfk_1")

  @@index([CaseID], map: "CaseID")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  model     String   @db.VarChar(100)
  operation String   @db.VarChar(10) // create, update, delete
  userId    Int?
  dataOld   Json?
  dataNew   Json?
  timestamp DateTime @default(now())
}

model ActionLog {
  id             Int      @id @default(autoincrement())
  CaseId         String
  ReferenceId    String?
  model          String   @db.VarChar(100)
  dataOld        String   @db.VarChar(50)
  dataNew        String   @db.VarChar(50)
  changedBy      Int?
  ChangeAt       DateTime @default(now())
  logDescription String?  @db.Text

  changedByUser      User?            @relation(fields: [changedBy], references: [IDUser]) // Define the relation
  CaseID_toActionLog caseinformation? @relation(fields: [CaseId], references: [CaseID])
}

model contact_information {
  ContactID         Int                 @id @default(autoincrement())
  SiteAccountID     Int?
  Salutation        String?             @db.VarChar(20)
  FirstName         String              @db.VarChar(100)
  LastName          String              @db.VarChar(100)
  Email             String?             @db.VarChar(255)
  PreferredLanguage String?             @db.VarChar(50)
  Phone             String?             @db.VarChar(50)
  Mobile            String?             @db.VarChar(50)
  WorkPhone         String?             @db.VarChar(50)
  WorkExtension     String?             @db.VarChar(10)
  OtherPhone        String?             @db.VarChar(50)
  OtherExtension    String?             @db.VarChar(10)
  Fax               String?             @db.VarChar(50)
  AddressLine1      String?             @db.VarChar(255)
  AddressLine2      String?             @db.VarChar(255)
  City              String?             @db.VarChar(100)
  StateProvince     String?             @db.VarChar(100)
  Country           String?             @db.VarChar(100)
  ZipPostalCode     String?             @db.VarChar(20)

  PIC_Name          String?             @db.VarChar(100)
  PIC_Email          String?             @db.VarChar(100)
  PIC_Phone          String?             @db.VarChar(100)
  asset_information asset_information[]
  caseinformation   caseinformation[]
  site_account      site_account?       @relation(fields: [SiteAccountID], references: [SiteAccountID], onDelete: Restrict, onUpdate: Restrict, map: "contact_information_ibfk_1")

  @@index([SiteAccountID], map: "SiteAccountID")
}

model global_trade_check {
  id_gtc              Int    @id @default(autoincrement())
  global_trade_status String @db.VarChar(30)
  embargoed_country   String @db.VarChar(30)
  gt_override_reason  String @db.VarChar(30)
  gt_details          String @db.VarChar(50)
  screening_id        String @db.VarChar(25)
  gt_active_listening String @db.VarChar(30)
  gt_al_comments      String @db.VarChar(50)

  caseinformation caseinformation[]
}

model materialorder {
  MOID                String              @id @db.VarChar(13)
  WOID                String?             @db.VarChar(13)
  OrderNumber         String?             @db.VarChar(100)
  OrderStatus         MaterialOrderStatus @default(New)
  OrderType           String?             @db.VarChar(50)
  CreatedOn           DateTime?           @default(now()) @db.DateTime(0)
  SalesOrderNumber    String?             @db.VarChar(100)
  RMANumber           String?             @db.VarChar(100)
  ReadyForClosureDate DateTime?           @db.DateTime(0)

  ShippingPriority           ShippingPriority? @default(MEDIUM)
  CustomerInducedDamage      Boolean?          @default(false)
  AccidentalDamageProtection Boolean?          @default(false)
  DefectiveMediaRetention    Boolean?          @default(false)

  DeliveryRequestedDate   DateTime?       @db.DateTime(0)
  CollectionRequestedDate DateTime?       @db.DateTime(0)
  PromoCode               String?         @db.VarChar(50)
  NotificationNumber      String?         @db.VarChar(100)
  ParentMOID              String?         @db.VarChar(13)
  IsBCPOrder              Boolean?        @default(false)
  MaterialOrderType       String?         @db.VarChar(50)
  EOTOrderNumber          String?         @db.VarChar(50)
  ResourceId              String?         @db.VarChar(255)
  parentMO                materialorder?  @relation("ParentMaterialOrder", fields: [ParentMOID], references: [MOID], onDelete: Restrict)
  childMOs                materialorder[] @relation("ParentMaterialOrder")

  OwnerID Int?
  owner   User? @relation("UserMaterialOrders", fields: [OwnerID], references: [IDUser], onDelete: Restrict)

  workorder              workorder?               @relation(fields: [WOID], references: [WOID], onDelete: Restrict, map: "materialorder_ibfk_1")
  materialorderlineitems materialorderlineitems[]

  @@index([WOID], map: "WOID")
  @@index([ResourceId], map: "ResourceId")
  @@index([OwnerID])
}

model materialorderlineitems {
  LineItemID  Int                         @id @default(autoincrement())
  MOID        String?                     @db.VarChar(13)
  LineNumber  Int?
  PartNumber  String?                     @db.VarChar(100)
  Description String?                     @db.Text
  ATPStatus   String?                     @db.VarChar(50)
  Quantity    Int?
  Status      MaterialOrderLineItemStatus @default(New)
  Price       Decimal?                    @db.Decimal(10, 2)

  // Revisi Tambahan
  FunctionalEquivalence   String?                    @db.VarChar(100)
  MediaHandlingPart       String?                    @db.VarChar(100)
  PickPackInstructions    String?                    @db.Text
  CollectionInstructions  CollectionInstructionType? @default(None)
  CustomerResponse        String?                    @db.Text
  RejectedReason          String?                    @db.Text
  OtherReason             String?                    @db.Text
  PartAuthorizationReason String?                    @db.Text
  PartAuthorizationDetail String?                    @db.Text
  OriginalPartNumber      String?                    @db.VarChar(100)
  OfferedPartNumber       String?                    @db.VarChar(100)
  OfferedPartDescription  String?                    @db.Text
  MainComponent           String?                    @db.VarChar(100)

  SerialNumber           String? @db.VarChar(100)
  RemovedPartNumber      String? @db.VarChar(100)
  RemovedSerialNumber    String? @db.VarChar(100)
  RemovedPartDescription String? @db.Text

  // Foreign key ke Failure
  FailureId Int?
  failure   Failure? @relation(fields: [FailureId], references: [FailureId], onDelete: SetNull)

  materialorder        materialorder?        @relation(fields: [MOID], references: [MOID], onDelete: Restrict, map: "materialorderlineitems_ibfk_1")
  servicecatalog_parts servicecatalog_parts? @relation(fields: [PartNumber], references: [PartNumber], onDelete: Restrict, map: "materialorderlineitems_ibfk_2")

  @@index([MOID], map: "MOID")
  @@index([PartNumber], map: "PartNumber")
}

model Failure {
  FailureId   Int     @id @default(autoincrement())
  Name        String
  Description String?

  materialorderlineitems materialorderlineitems[]
}

model product_information {
  ProductNumber       String              @id @db.VarChar(11)
  ProductLine         String              @db.VarChar(3)
  ProductName         String              @db.VarChar(255)
  ProductTypeID       Int
  end_of_sales_date   DateTime?           @db.Date
  end_of_support_date DateTime?           @db.Date
  vendor              String?             @db.VarChar(50)
  asset_information   asset_information[]
  product_type        product_type        @relation(fields: [ProductTypeID], references: [ProductTypeID], onUpdate: Restrict, map: "product_information_ibfk_1")

  @@index([ProductTypeID], map: "ProductTypeID")
}

model product_type {
  ProductTypeID       Int                        @id @default(autoincrement())
  ProductType         String                     @db.VarChar(50)
  ProductTower        product_type_ProductTower?
  ProductGroup        product_type_ProductGroup?
  product_information product_information[]
}

model servicecatalog {
  ServiceCatalogID         Int                        @id @default(autoincrement())
  AssetID                  Int
  Service_offerID          String                     @db.VarChar(8)
  PartNumber               String?                    @db.VarChar(100)
  WarrantyStatus           String?                    @db.VarChar(50)
  Currency                 String?                    @db.VarChar(10)
  Price                    Decimal?                   @db.Decimal(10, 2)
  Tax                      Decimal?                   @db.Decimal(10, 2)
  Total                    Decimal?                   @db.Decimal(10, 2)
  asset_information        asset_information          @relation(fields: [AssetID], references: [AssetID], map: "servicecatalog_ibfk_1")
  servicecatalog_parts     servicecatalog_parts?      @relation(fields: [PartNumber], references: [PartNumber], onDelete: Restrict, map: "servicecatalog_ibfk_2")
  warranty_services        warranty_services          @relation(fields: [Service_offerID], references: [Service_offerID], map: "servicecatalog_ibfk_3")
  caseinformation          caseinformation[]
  serviceCatalogManytoMany ServiceCatalogManytoMany[]

  @@index([AssetID], map: "AssetID")
  @@index([PartNumber], map: "PartNumber")
  @@index([Service_offerID], map: "Service_offerID")
}

model servicecatalog_parts {
  PartNumber               String                     @id @db.VarChar(100)
  Keyword                  String?                    @db.VarChar(100)
  PartDescription          String?                    @db.Text
  Orderability             Boolean?
  RestrictionReason        String?                    @db.Text
  CSR_Flag                 Boolean?                   @default(false)
  ROHS_Flag                Boolean?                   @default(false)
  Returnable_Flag          Boolean?                   @default(false)
  HardRoll_Flag            Boolean?                   @default(false)
  DangerousGoods_Flag      Boolean?                   @default(false)
  LithiumBattery_Flag      Boolean?                   @default(false)
  Oversize_Flag            Boolean?                   @default(false)
  Heavy_Flag               Boolean?                   @default(false)
  Price                    Decimal                    @default(0.00) @db.Decimal(10, 2)
  FreightPrice             Decimal                    @default(0.00) @db.Decimal(10, 2)
  Tax                      Decimal                    @default(0.00) @db.Decimal(10, 2)
  Total                    Decimal                    @default(0.00) @db.Decimal(10, 2)
  Shipping_Fee             Decimal                    @db.Decimal(10, 2)
  materialorderlineitems   materialorderlineitems[]
  servicecatalog           servicecatalog[]
  serviceCatalogManytoMany ServiceCatalogManytoMany[]
}

model ServiceCatalogManytoMany {
  id               Int    @id @default(autoincrement())
  ServiceCatalogID Int
  PartNumber       String

  servicecatalog servicecatalog       @relation(fields: [ServiceCatalogID], references: [ServiceCatalogID])
  part           servicecatalog_parts @relation(fields: [PartNumber], references: [PartNumber])

  @@unique([ServiceCatalogID, PartNumber])
}

model site_account {
  SiteAccountID       Int                   @id @default(autoincrement())
  Company             String                @db.VarChar(255)
  Email               String?               @db.VarChar(255)
  PrimaryPhone        String?               @db.VarChar(50)
  WhatsappNo          String?               @db.VarChar(50)
  AddressLine1        String                @db.VarChar(255)
  AddressLine2        String?               @db.VarChar(255)
  City                String                @db.VarChar(100)
  StateProvince       String?               @db.VarChar(100)
  Country             String                @db.VarChar(100)
  ZipPostalCode       String                @db.VarChar(20)
  asset_information   asset_information[]
  caseinformation     caseinformation[]
  contact_information contact_information[]
}

model symptom_codes {
  SymptomCodeID   Int               @id @default(autoincrement())
  SymptomCode     String            @db.VarChar(50)
  TopCategory     String            @db.VarChar(50)
  SubCategory     String            @db.VarChar(50)
  QualityCodes    String?           @db.VarChar(50)
  CreatedOn       DateTime          @default(now()) @db.Timestamp(0)
  caseinformation caseinformation[]
}

model test_table_without_migration {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(12)

  @@map("test-table-without-migration")
}

model test_table {
  MOID                Int       @id @default(autoincrement())
  WOID                Int?
  OrderNumber         String?   @db.VarChar(100)
  OrderStatus         String?   @db.VarChar(50)
  OrderType           String?   @db.VarChar(50)
  CreatedOn           DateTime? @default(now()) @db.DateTime(0)
  SalesOrderNumber    String?   @db.VarChar(100)
  RMANumber           String?   @db.VarChar(100)
  ReadyForClosureDate DateTime? @db.DateTime(0)
  Owner               String?   @db.VarChar(100)

  @@index([WOID], map: "WOID")
}

model User {
  IDUser       Int      @id @default(autoincrement())
  Email        String   @unique @db.VarChar(255)
  Username     String   @unique @db.VarChar(100)
  Password     String   @db.VarChar(255)
  Name         String   @db.VarChar(255)
  Role         String   @default("user") @db.VarChar(50)
  ProfilePhoto String?  @db.VarChar(500)
  CreatedAt    DateTime @default(now())
  UpdatedAt    DateTime @updatedAt
  Phone        String?  @db.VarChar(20)
  Signature    String?  @db.VarChar(500)
  ResourceId   String?  @db.VarChar(255)
  resource     Resource? @relation(fields: [ResourceId], references: [ResourceId]) 


  caseinformations_created caseinformation[] @relation("UserCreatedCases")
  caseinformations_owned   caseinformation[] @relation("UserOwnedCases")
  bookings_created         Bookings[]        @relation("UserCreatedBookings")

  workorders_owned     workorder[]     @relation("UserWorkOrders")
  materialorders_owned materialorder[] @relation("UserMaterialOrders")
  ActionLog            ActionLog[]
}

model warranty_services {
  Service_offerID     String           @id @db.VarChar(8)
  Service_description String           @db.VarChar(255)
  CTat_RTime          String?          @db.VarChar(5)
  Price               Float            @default(0) @db.Float
  Shipping_Fee        Float            @default(0) @db.Float
  qty_ws              Int              @default(0)
  Tax                 Float            @default(0) @db.Float
  Total               Float            @default(0) @db.Float
  servicecatalog      servicecatalog[]
}

model SubkTechnician {
  SubkTechnicianId String @id @db.VarChar(255)
  Name             String @db.VarChar(255)

  // Foreign key to ResourceAccount
  ResourceAccountId String?          @db.VarChar(255)
  resourceAccount   ResourceAccount? @relation(fields: [ResourceAccountId], references: [ResourceAccountId])

  bookingDetails BookingDetails[]
}

model Bookings {
  BookingId     Int     @id @default(autoincrement())
  BookingStatus String? @db.VarChar(100)
  WOID          String

  // SLA  
  ScheduleJeopardy     Boolean?
  ScheduleJeopardyTime DateTime?

  DoNotDisturb     Boolean?
  CeScheduleChange Boolean?
  CreatedAt        DateTime @default(now()) @db.DateTime(0)
  CreatedBy        Int

  // TotalDuration
  TotalBillableDurationInMinutes   Int?
  TotalInProgressDurationInMinutes Int?
  TotalBreakDurationInMinutes      Int?

  workorder workorder? @relation("WorkOrderBookingsCase", fields: [WOID], references: [WOID], onDelete: Restrict)

  // Relations
  createdByUser User @relation("UserCreatedBookings", fields: [CreatedBy], references: [IDUser], onDelete: Restrict)

  bookingDetails BookingDetails[]

  @@index([WOID], map: "fk_address_workorder")
}

model BookingDetails {
  BookingDetailId   Int     @id @default(autoincrement())
  BookingId         Int
  ResourceId        String?
  ResourceAccountId String?
  SubkTechnicianId  String?
  Name              String  @db.VarChar(255)
  Status            String  @db.VarChar(50)

  // Customer Time
  StartTimeCustomerTime            DateTime?
  EndTimeCustomerTime              DateTime?
  EstimatedArrivalTimeCustomerTime DateTime?
  ActualArrivalTimeCustomerTime    DateTime?

  // User Time
  StartTimeUserTime            DateTime?
  EndTimeUserTime              DateTime?
  DurationInMinutesUserTime    Int?
  EstimatedArrivalTimeUserTime DateTime?
  ActualArrivalTimeUserTime    DateTime?

  ChangedAt DateTime @default(now()) @db.DateTime(0)
  ChangedBy Int

  resource        Resource?        @relation(fields: [ResourceId], references: [ResourceId], onDelete: Restrict, onUpdate: Cascade)
  resourceaccount ResourceAccount? @relation(fields: [ResourceAccountId], references: [ResourceAccountId], onDelete: Restrict, onUpdate: Cascade)
  subkTechnician  SubkTechnician?  @relation(fields: [SubkTechnicianId], references: [SubkTechnicianId], onDelete: Restrict, onUpdate: Cascade)
  booking         Bookings         @relation(fields: [BookingId], references: [BookingId], onDelete: Cascade)
}

model workorder {
  WOID            String          @id @db.VarChar(13)
  CaseID          String?
  WorkOrderNumber String?         @db.VarChar(100)
  WorkOrderType   String?         @db.VarChar(50)
  Priority        String?         @db.VarChar(50)
  SystemStatus    WorkOrderStatus @default(OPEN_UNSCHEDULED)
  SubStatus       String?         @db.VarChar(50)
  PreferredDay    DateTime?       @db.Date
  PreferredTime   DateTime?       @db.Time(0)
  ShipmentCountry String?         @db.VarChar(50)
  ShipmentState   String?         @db.VarChar(50)
  CreatedOn       DateTime?       @default(now()) @db.DateTime(0)
  ChangedDate     DateTime?       @default(now()) @db.DateTime(0)
  OwnerID         Int?
  owner           User?           @relation("UserWorkOrders", fields: [OwnerID], references: [IDUser], onDelete: Restrict)

  SLAJeopardy                 String?          @db.VarChar(50)
  DueDateCustomer             DateTime?        @db.DateTime(0)
  CoverageWindow              String?          @db.VarChar(100)
  Response                    String?          @db.VarChar(100)
  // OTCCode                     String?          @db.VarChar(50)
  RequestedDateTimeCustomer   DateTime?        @db.DateTime(0)
  GuaranteedFixTimeCustomer   DateTime?        @db.DateTime(0)
  EarlyStartDateTimeCustomer  DateTime?        @db.DateTime(0)
  LatestStartDateTimeCustomer DateTime?        @db.DateTime(0)
  SLAReschedule               String?          @db.VarChar(50)
  ActiveScheduleDate          DateTime?        @db.DateTime(0)
  SLAErrorDescription         String?          @db.Text
  CasePriorityIndex           Int?
  PartnerStatus               String?          @db.VarChar(50)
  WorkOrderDescription        String?          @db.Text
  PartnerNotes                String?          @db.Text
  IncomingChannel             String?          @db.VarChar(50)
  materialorder               materialorder[]
  caseinformation             caseinformation? @relation(fields: [CaseID], references: [CaseID], onDelete: Restrict, map: "workorder_ibfk_1")
  bookings                    Bookings[]       @relation("WorkOrderBookingsCase")

  @@index([CaseID], map: "CaseID")
  @@index([OwnerID])
}

model Resource {
  ResourceId String @id @db.VarChar(255)
  Name       String @db.VarChar(255)

  // Relations
  resourceAccounts ResourceAccount[] // <-- 1 Resource has many ResourceAccounts
  bookingDetails   BookingDetails[]
  users           User[]
}

model ResourceAccount {
  ResourceAccountId String @id @db.VarChar(255)
  Name              String @db.VarChar(255)

  // Foreign key to Resource
  ResourceId String?   @db.VarChar(255)
  resource   Resource? @relation(fields: [ResourceId], references: [ResourceId])

  // Relations
  subkTechnicians SubkTechnician[] // <-- 1 ResourceAccount has many SubkTechnicians
  bookingDetails  BookingDetails[]
}

model workorder_service_delivery {
  ServiceDeliveryID Int       @id @default(autoincrement())
  WOID              String?   @db.VarChar(13)
  ServiceType       String?   @db.VarChar(100)
  StartDateTime     DateTime? @db.DateTime(0)
  EndDateTime       DateTime? @db.DateTime(0)

  @@index([WOID], map: "fk_service_workorder")
}

model workorder_service_delivery_address {
  AddressID        Int     @id @default(autoincrement())
  WOID             String? @db.VarChar(13)
  CompanyName      String? @db.VarChar(100)
  ContactFirstName String? @db.VarChar(100)
  ContactLastName  String? @db.VarChar(100)
  PhoneNumber      String? @db.VarChar(50)
  Email            String? @db.VarChar(100)
  AddressLine1     String? @db.VarChar(200)
  AddressLine2     String? @db.VarChar(200)
  AddressLine3     String? @db.VarChar(200)
  City             String? @db.VarChar(100)
  StateOrProvince  String? @db.VarChar(100)
  CountryOrRegion  String? @db.VarChar(100)
  PostalCode       String? @db.VarChar(20)
  TimeZone         String? @db.VarChar(50)
  ServiceTerritory String? @db.VarChar(100)
  BusinessSegment  String? @db.VarChar(100)
